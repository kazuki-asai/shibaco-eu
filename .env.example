# Copy to .env.local. Vite reads it for `npm run dev` and `npm run build`.
# Do not commit real shop codes.

# ShopWorks shop code, sent as X-Shop-Code.
VITE_SHOP_CODE=

# Leave unset in local dev to use the Vite proxy below.
# On Render, set this to the ShopWorks origin, including the trailing path only if
# you do not call `/api/...` yourself. Production today uses:
# https://shopworks.onrender.com
VITE_API_BASE_URL=

# Vite dev-server and prerender proxy for /api and /rails.
# Local ShopWorks: http://host.docker.internal:3001
# Shared preview API: https://shopworks.onrender.com
VITE_PROXY_TARGET=https://shopworks.onrender.com

# Overseas checkout stays closed unless this is exactly true.
# A country rate from ShopWorks, including 0, does not open checkout by itself.
# Turn it on only after ShopWorks charges that country rate on the Stripe session.
VITE_OVERSEAS_CHECKOUT_ENABLED=false

# Optional overrides. Defaults match the tags already used on the store.
# VITE_GA_MEASUREMENT_ID=G-8108T1M9BS
# VITE_GOOGLE_ADS_ID=AW-18390381994

# --- server/ only (not used by the Render static site) ---
# STRIPE_SECRET_KEY=
# CLIENT_URL=http://localhost:5173
# PORT=3002
